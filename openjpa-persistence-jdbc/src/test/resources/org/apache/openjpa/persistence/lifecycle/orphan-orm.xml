<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
    https://jakarta.ee/xml/ns/persistence/orm/orm_3_2.xsd"
                 version="3.2">
    <entity class="org.apache.openjpa.persistence.lifecycle.entity.OrphanXmlParent"
            access="FIELD">
        <table name="ORPHAN_XML_PARENT"/>
        <attributes>
            <id name="id"/>
            <one-to-many name="children" mapped-by="parent" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
            <one-to-many name="items" orphan-removal="true">
                <join-table name="ORPHAN_XML_PARENT_ITEM"/>
                <cascade>
                    <cascade-persist/>
                    <cascade-remove/>
                </cascade>
            </one-to-many>
            <one-to-one name="detail" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-one>
            <one-to-one name="extra" orphan-removal="true">
                <join-column name="EXTRA_ID"/>
                <cascade>
                    <cascade-persist/>
                    <cascade-remove/>
                </cascade>
            </one-to-one>
        </attributes>
    </entity>
    <entity class="org.apache.openjpa.persistence.lifecycle.entity.OrphanXmlChild"
            access="FIELD">
        <table name="ORPHAN_XML_CHILD"/>
        <attributes>
            <id name="id"/>
            <basic name="name"/>
            <many-to-one name="parent"/>
        </attributes>
    </entity>
    <entity class="org.apache.openjpa.persistence.lifecycle.entity.OrphanXmlItem"
            access="FIELD">
        <table name="ORPHAN_XML_ITEM"/>
        <attributes>
            <id name="id"/>
            <basic name="name"/>
        </attributes>
    </entity>
    <entity class="org.apache.openjpa.persistence.lifecycle.entity.OrphanXmlDetail"
            access="FIELD">
        <table name="ORPHAN_XML_DETAIL"/>
        <attributes>
            <id name="id"/>
            <basic name="name"/>
        </attributes>
    </entity>
</entity-mappings>
